<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{HTTP_HOST} ^(www\.)?wayaenikah\.com$ [NC]

    # Route public theme demos through Laravel even when a physical
    # /demo directory exists in the project root on shared hosting.
    RewriteRule ^demo(?:/.*)?$ public/index.php [L]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

