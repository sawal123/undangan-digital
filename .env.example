APP_NAME="Undangan Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=undangan_digital
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

LOGIN_FAILED_MAX_PER_EMAIL_IP=5
LOGIN_FAILED_DECAY_SECONDS=60
LOGIN_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPTS_DECAY_SECONDS=900
REGISTER_PER_IP_HOUR=3
REGISTER_PER_IP_DAY=10
BLOCK_DISPOSABLE_EMAIL=false
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,10minutemail.com,tempmail.com
SECURITY_ALERT_EMAIL_ENABLED=false
SECURITY_ALERT_EMAIL=
SECURITY_ALERT_COOLDOWN_MINUTES=30
AUTH_LOG_RETENTION_DAYS=90
AUTH_HIGH_RISK_RETENTION_DAYS=365
